---
interface Props {
  t: any;
}

const { t } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="text-center py-8 px-6 text-text-light text-xs relative z-10 border-t border-primary/15">
  <div class="flex justify-center gap-6 mb-3">
    <a href="https://github.com/Webioinfo01" target="_blank" rel="noopener" class="footer-link">GitHub</a>
    <a href="https://www.npmjs.com/org/webioinfo" target="_blank" rel="noopener" class="footer-link">npm</a>
  </div>
  <p>© {year} webioinfo · {t}</p>
</footer>
