---
interface Props {
  t: any;
  lang: string;
}

const { t, lang } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${basePath}${path}`;
const homeHref = withBase(lang === 'zh' ? '/zh/' : '/');
const langHref = withBase(lang === 'zh' ? '/' : '/zh');
const logoPath = withBase('/logo.png');
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-cream/80 border-b border-primary/10">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href={homeHref} class="flex items-center gap-2.5 font-semibold text-text no-underline shrink-0">
      <img src={logoPath} alt="webioinfo logo" class="h-9 w-9 sm:h-10 sm:w-10 rounded-lg object-contain" />
      <span class="hidden sm:inline text-xl tracking-tight font-semibold text-text">webioinfo</span>
    </a>
    <nav class="flex items-center gap-1.5 sm:gap-3">
      <a href={langHref} class="px-2 py-1 text-sm font-medium text-text-light hover:text-primary-dark transition-colors rounded-md hover:bg-primary/10">
        {lang === 'zh' ? 'EN' : '中'}
      </a>
      <div class="w-px h-5 bg-primary/20"></div>
      <a href="https://github.com/Webioinfo01" target="_blank" rel="noopener" class="flex items-center gap-2 px-2 sm:px-4 py-2 rounded-lg text-text-light hover:text-primary-dark bg-white/50 border border-primary/15 hover:border-primary/30 transition-all duration-300 group" aria-label="Follow us on GitHub">
        <svg class="w-5 h-5 group-hover:scale-110 transition-transform" viewBox="0 0 16 16" fill="currentColor"><path d="M2 5.5a3.5 3.5 0 1 1 5.898 2.549 5.508 5.508 0 0 1 3.034 4.084.75.75 0 1 1-1.482.235 4.001 4.001 0 0 0-6.9 0 .75.75 0 0 1-1.482-.236A5.507 5.507 0 0 1 6.102 8.05 3.493 3.493 0 0 1 2 5.5zM11 4a.75.75 0 1 0 0 1.5 1.5 1.5 0 0 1 .666 2.844.75.75 0 0 0-.416.672v.352a.75.75 0 0 0 .574.73c1.2.289 2.162 1.2 2.522 2.372a.75.75 0 1 0 1.434-.44 5.01 5.01 0 0 0-2.56-3.012A3 3 0 0 0 11 4z"/></svg>
        <span class="text-sm font-mono font-medium hidden sm:inline">Follow Us</span>
      </a>
    </nav>
  </div>
</header>
