---
interface Props {
  t: any;
  lang: string;
}

const { t, lang } = Astro.props;
const base = lang === 'zh' ? '/zh' : '';
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-cream/80 border-b border-primary/10">
  <div class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">
    <a href={`${base}/`} class="flex items-center gap-2 font-display text-2xl font-bold text-text no-underline">
      <img src="/logo.png" alt="webioinfo logo" class="h-8 w-8 object-contain" />
      <span class="text-gradient">webio</span>info
    </a>
    <nav class="flex items-center gap-7">
      <a href={`${base}/`} class="text-sm font-semibold no-underline transition-colors text-text-light hover:text-primary-dark">{t.nav.home}</a>
      <a href={lang === 'zh' ? '/' : '/zh'} class="text-xs font-bold px-3 py-1.5 rounded-full bg-primary/10 text-primary-dark no-underline hover:bg-primary/20 transition-colors">
        {lang === 'zh' ? 'EN' : '中文'}
      </a>
    </nav>
  </div>
</header>
