---
interface Props {
  t: any;
  lang: string;
  current?: 'home' | 'about' | 'projects';
}

const { t, lang, current } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${basePath}${path}`;
const homeHref = withBase(lang === 'zh' ? '/zh/' : '/');
const logoPath = withBase('/logo.png');

// Build lang-switch href from current path
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
let langHref: string;
if (lang === 'zh') {
  langHref = currentPath.replace(/^\/zh(\/|$)/, '/') || '/';
} else {
  langHref = currentPath === '/' ? '/zh/' : `/zh${currentPath}`;
}
langHref = withBase(langHref);
---

<header class="sticky top-0 z-50 backdrop-blur-md border-b" style="background: var(--t-header-bg); border-color: var(--t-border);">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href={homeHref} class="flex items-center gap-2.5 font-semibold no-underline shrink-0" style="color: var(--t-text);">
      <img src={logoPath} alt="webioinfo logo" class="h-9 w-9 sm:h-10 sm:w-10 rounded-lg object-contain" />
      <span class="hidden sm:inline text-xl tracking-tight font-semibold" style="color: var(--t-text);">webioinfo</span>
    </a>
    <nav class="flex items-center gap-1.5 sm:gap-3">
      <a href={homeHref} class:list={["px-2 py-1 text-sm font-medium transition-colors rounded-md hover:bg-primary/10", current === 'home' ? "font-semibold" : ""]} style={current === 'home' ? "color: var(--t-text);" : "color: var(--t-text-light);"}>
        {lang === 'zh' ? '首页' : 'Home'}
      </a>
      <div class="w-px h-5" style="background: var(--t-border);"></div>
      <a href={withBase(lang === 'zh' ? '/zh/projects' : '/projects')} class:list={["px-2 py-1 text-sm font-medium transition-colors rounded-md hover:bg-primary/10", current === 'projects' ? "font-semibold" : ""]} style={current === 'projects' ? "color: var(--t-text);" : "color: var(--t-text-light);"}>
        {lang === 'zh' ? '项目' : 'Projects'}
      </a>
      <div class="w-px h-5" style="background: var(--t-border);"></div>
      <a href={withBase(lang === 'zh' ? '/zh/about' : '/about')} class:list={["px-2 py-1 text-sm font-medium transition-colors rounded-md hover:bg-primary/10", current === 'about' ? "font-semibold" : ""]} style={current === 'about' ? "color: var(--t-text);" : "color: var(--t-text-light);"}>
        {lang === 'zh' ? '关于' : 'About'}
      </a>
      <div class="w-px h-5" style="background: var(--t-border);"></div>
      <button id="theme-toggle" class="p-1.5 transition-colors" style="color: var(--t-text-light);" aria-label="Toggle theme">
        <svg class="w-5 h-5 dark-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72 1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        <svg class="w-5 h-5 light-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      <div class="w-px h-5" style="background: var(--t-border);"></div>
      <a href={langHref} class="px-2 py-1 text-sm font-medium transition-colors rounded-md hover:bg-primary/10" style="color: var(--t-text-light);">
        {lang === 'zh' ? 'EN' : '中'}
      </a>
      <div class="w-px h-5" style="background: var(--t-border);"></div>
      <a href="https://github.com/Webioinfo01" target="_blank" rel="noopener" class="flex items-center gap-2 px-2 sm:px-4 py-2 rounded-lg border transition-all duration-300 group" aria-label="Follow us on GitHub" style="color: var(--t-text-light); background: var(--t-detail-bg); border-color: var(--t-detail-border);">
        <svg class="w-5 h-5 group-hover:scale-110 transition-transform" viewBox="0 0 16 16" fill="currentColor"><path d="M2 5.5a3.5 3.5 0 1 1 5.898 2.549 5.508 5.508 0 0 1 3.034 4.084.75.75 0 1 1-1.482.235 4.001 4.001 0 0 0-6.9 0 .75.75 0 0 1-1.482-.236A5.507 5.507 0 0 1 6.102 8.05 3.493 3.493 0 0 1 2 5.5zM11 4a.75.75 0 1 0 0 1.5 1.5 1.5 0 0 1 .666 2.844.75.75 0 0 0-.416.672v.352a.75.75 0 0 0 .574.73c1.2.289 2.162 1.2 2.522 2.372a.75.75 0 1 0 1.434-.44 5.01 5.01 0 0 0-2.56-3.012A3 3 0 0 0 11 4z"/></svg>
        <span class="text-sm font-mono font-medium hidden sm:inline">{lang === 'zh' ? '关注我们' : 'Follow Us'}</span>
      </a>
    </nav>
  </div>
</header>
