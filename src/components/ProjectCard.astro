---
interface Props {
  icon: string;
  name: string;
  detail: string;
  links: { label: string; href: string; primary?: boolean }[];
}

const { icon, name, detail, links } = Astro.props;
---

<a href={links[0]?.href || '#'} target="_blank" rel="noopener" class="detail-card mb-6 last:mb-0">
  <div class="text-4xl shrink-0 w-13 text-center">{icon}</div>
  <div class="flex-1">
    <h3 class="font-display text-xl font-semibold mb-2">{name}</h3>
    <p class="text-text-light text-sm leading-7 mb-3.5">{detail}</p>
    <div class="flex flex-wrap gap-2">
      {links.map(({ label, href, primary }: any) => (
        <span class:list={["inline-block px-3.5 py-1.5 rounded-full text-xs font-bold", primary ? "bg-gradient-to-br from-primary to-secondary text-white" : "bg-white/70 border border-primary/20 text-text"]}>
          {label}
        </span>
      ))}
    </div>
  </div>
</a>
