---
import Header from './Header.astro';
import ProjectCard from './ProjectCard.astro';
import Footer from './Footer.astro';

interface Props {
  t: any;
  lang: string;
}

const { t, lang } = Astro.props;

const projectKeys = ['aweskill', 'awescholar', 'aweshelf', 'aweswitch', 'aweteam', 'awecolor'] as const;
const icons: Record<string, string> = { aweskill: '📦', awescholar: '📚', aweshelf: '🔖', aweswitch: '🔀', aweteam: '👥', awecolor: '🎨' };
const repos: Record<string, string> = {
  aweskill: 'https://github.com/Webioinfo01/aweskill',
  awescholar: 'https://github.com/mugpeng/awescholar',
  aweshelf: 'https://github.com/Webioinfo01/aweshelf',
  aweswitch: 'https://github.com/Webioinfo01/aweswitch',
  aweteam: 'https://github.com/Webioinfo01/aweteam',
  awecolor: 'https://github.com/Webioinfo01/awecolor',
};
---

<Header t={t} lang={lang} current="projects" />
<main class="max-w-3xl mx-auto px-6 pt-16 pb-12 relative z-10">
  <h1 class="text-center font-display text-4xl font-semibold mb-2">{t.projects_page.title}</h1>
  <p class="text-center text-base mb-10" style="color: var(--t-text-light);">{t.projects_page.subtitle}</p>
  <div class="desk p-10 md:p-14">
    {projectKeys.map((key) => (
      <ProjectCard
        icon={icons[key]}
        name={t.projects[key].name}
        detail={t.projects[key].detail}
        links={[
          { label: 'GitHub →', href: repos[key], primary: true },
          { label: 'npm', href: `https://www.npmjs.com/package/${key}` },
        ]}
      />
    ))}
  </div>
</main>
<Footer t={t.footer} />
