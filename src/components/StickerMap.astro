---
interface Props {
  title: string;
  subtitle: string;
  projects: Record<string, { name: string; desc: string; tags: string[]; link: string }>;
}

const { title, subtitle, projects } = Astro.props;

const cards = [
  { key: 'aweskill', color: 'pink', icon: '📦', rotate: '-2deg', tapeRotate: '-2deg', href: 'https://github.com/Webioinfo01/aweskill' },
  { key: 'aweswitch', color: 'lavender', icon: '🔀', rotate: '1.5deg', tapeRotate: '3deg', href: 'https://github.com/Webioinfo01/aweswitch' },
  { key: 'aweteam', color: 'mint', icon: '👥', rotate: '-1deg', tapeRotate: '-4deg', href: 'https://github.com/Webioinfo01/aweteam' },
  { key: 'awecolor', color: 'peach', icon: '🎨', rotate: '2deg', tapeRotate: '1deg', href: 'https://github.com/Webioinfo01/awecolor' },
];
---

<div id="projects" class="px-6 py-10 relative z-10 scroll-mt-20">
  <h2 class="text-center font-display text-3xl font-semibold mb-2">{title}</h2>
  <p class="text-center text-base md:text-lg text-text-light mb-10">{subtitle}</p>
  <div class="desk max-w-5xl mx-auto p-12 md:p-16">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 relative z-10">
      {cards.map(({ key, color, icon, rotate, tapeRotate, href }) => (
        <a href={href} data-confirm="true" class={`sticker sticker--${color}`} style={`transform: rotate(${rotate});`}>
          <div class="sticker-body">
            <div class="sticker-tape" style={`transform: translateX(-50%) rotate(${tapeRotate});`}></div>
            <div class="text-3xl mb-4">{icon}</div>
            <div class="font-display text-xl font-semibold mb-2.5">{projects[key].name}</div>
            <div class="text-sm leading-relaxed text-text-light flex-1 mb-4">{projects[key].desc}</div>
            <div class="flex flex-wrap gap-1.5 mb-3.5">
              {projects[key].tags.map((tag: string) => (
                <span class="sticker-tag">{tag}</span>
              ))}
            </div>
            <span class="sticker-link">{projects[key].link} →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('[data-confirm]').forEach(el => {
    el.addEventListener('click', e => {
      if (!confirm('即将跳转到 GitHub 页面，是否继续？')) {
        e.preventDefault();
      }
    });
  });
</script>
