---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import StickerMap from '../components/StickerMap.astro';
import Footer from '../components/Footer.astro';
import t from '../i18n/en.json';
---

<Layout title="webioinfo" lang="en">
  <Header t={t} lang="en" />
  <Hero t={{ ...t.hero, tagline: t.site.tagline, description: t.site.description }} />
  <StickerMap title={t.home_projects.title} subtitle={t.home_projects.subtitle} projects={t.projects} />
  <Footer t={t.footer} />
</Layout>
