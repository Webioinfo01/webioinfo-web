---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import t from '../../i18n/zh.json';

const a = t.about_page;
---

<Layout title="关于我们 — webioinfo" lang="zh">
  <Header t={t} lang="zh" current="about" />
  <main class="max-w-5xl mx-auto px-6 pt-16 pb-12 relative z-10">
    <!-- Title + QR code side by side -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-8 mb-10">
      <h1 class="font-display text-4xl font-semibold">{a.title}</h1>
      <div class="sticker sticker--lavender" style="transform: rotate(1.5deg);">
        <div class="sticker-tape"></div>
        <div class="sticker-body items-center text-center px-6 py-5">
          <p class="text-sm text-text-light mb-3">{a.contact.wechat}</p>
          <img src="/qr.jpg" alt="微信公众号二维码" class="rounded-xl w-36 h-36 object-cover shadow-md border-2 border-white/60" />
        </div>
      </div>
    </div>

    <div class="desk p-10 md:p-14 space-y-8">
      <!-- Mission -->
      <div class="sticker sticker--pink" style="transform: rotate(-0.5deg);">
        <div class="sticker-tape"></div>
        <div class="sticker-body">
          <h2 class="font-display text-xl font-semibold mb-3 flex items-center gap-2">
            <span>🎯</span> {a.mission.title}
          </h2>
          <p class="text-text-light text-base leading-7">{a.mission.text}</p>
        </div>
      </div>

      <!-- Values + Contact side by side -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Values -->
        <div>
          <h2 class="font-display text-xl font-semibold mb-5 text-center">{a.values.title}</h2>
          <div class="space-y-5">
            <div class="sticker sticker--mint" style="transform: rotate(1deg);">
              <div class="sticker-tape"></div>
              <div class="sticker-body">
                <h3 class="font-display text-lg font-semibold mb-2 flex items-center gap-2">
                  <span>🌍</span> {a.values.open.name}
                </h3>
                <p class="text-text-light text-base leading-7">{a.values.open.desc}</p>
              </div>
            </div>
            <div class="sticker sticker--lavender" style="transform: rotate(-1deg);">
              <div class="sticker-tape"></div>
              <div class="sticker-body">
                <h3 class="font-display text-lg font-semibold mb-2 flex items-center gap-2">
                  <span>🔗</span> {a.values.connect.name}
                </h3>
                <p class="text-text-light text-base leading-7">{a.values.connect.desc}</p>
              </div>
            </div>
            <div class="sticker sticker--peach" style="transform: rotate(0.5deg);">
              <div class="sticker-tape"></div>
              <div class="sticker-body">
                <h3 class="font-display text-lg font-semibold mb-2 flex items-center gap-2">
                  <span>🌱</span> {a.values.grow.name}
                </h3>
                <p class="text-text-light text-base leading-7">{a.values.grow.desc}</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Contact -->
        <div>
          <h2 class="font-display text-xl font-semibold mb-5 text-center">{a.contact.title}</h2>
          <div class="space-y-5">
            <a href="https://space.bilibili.com/1410491002" target="_blank" rel="noopener" class="sticker sticker--mint" style="transform: rotate(-0.5deg);">
              <div class="sticker-tape"></div>
              <div class="sticker-body">
                <h3 class="font-display text-lg font-semibold mb-1 flex items-center gap-2">
                  <span>📺</span> {a.contact.bilibili}
                </h3>
                <p class="text-text-light text-sm">space.bilibili.com/1410491002</p>
              </div>
            </a>
            <a href="mailto:mugpeng@outlook.com" class="sticker sticker--pink" style="transform: rotate(1deg);">
              <div class="sticker-tape"></div>
              <div class="sticker-body">
                <h3 class="font-display text-lg font-semibold mb-1 flex items-center gap-2">
                  <span>✉️</span> {a.contact.email}
                </h3>
                <p class="text-text-light text-sm">mugpeng@outlook.com</p>
              </div>
            </a>
            <a href="https://www.bilibili.com/video/BV1vUCNYoEf3" target="_blank" rel="noopener" class="sticker sticker--peach" style="transform: rotate(-1deg);">
              <div class="sticker-tape"></div>
              <div class="sticker-body">
                <h3 class="font-display text-lg font-semibold mb-1 flex items-center gap-2">
                  <span>🎬</span> {a.contact.video}
                </h3>
                <p class="text-text-light text-sm">BV1vUCNYoEf3</p>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer t={t.footer} />
</Layout>
